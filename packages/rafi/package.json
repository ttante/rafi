{
  "name": "@rafi-ai/cli",
  "version": "0.2.0",
  "description": "Rafi CLI — scaffold and compile AI framework configs for a target repo.",
  "type": "module",
  "bin": {
    "rafi": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "bundledDependencies": ["rafi-spec"],
  "dependencies": {
    "special-agents": "workspace:*",
    "rafi-spec": "workspace:*",
    "@clack/prompts": "^1.4.0",
    "commander": "^12.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
