{
  "name": "@rafi-ai/cli",
  "version": "0.9.11",
  "description": "Interactive AI app engineering for Claude and Codex: interview, plan, ticket, and build with QA.",
  "preferGlobal": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttante/rafi.git",
    "directory": "packages/rafi"
  },
  "bugs": {
    "url": "https://github.com/ttante/rafi/issues"
  },
  "homepage": "https://github.com/ttante/rafi#readme",
  "bin": {
    "rafi": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "ai-foreman": "1.7.11",
    "ajv": "^8.20.0",
    "commander": "^12.1.0",
    "rafi-spec": "0.8.7",
    "special-agents": "0.8.7",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
