{
  "name": "@rafi-ai/cli",
  "version": "0.4.0",
  "description": "Rafi CLI — scaffold and compile AI framework configs for a target repo.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttante/rafi.git",
    "directory": "packages/rafi"
  },
  "bugs": {
    "url": "https://github.com/ttante/rafi/issues"
  },
  "homepage": "https://github.com/ttante/rafi#readme",
  "bin": {
    "rafi": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ai-foreman": "1.1.0",
    "special-agents": "0.4.0",
    "rafi-spec": "0.4.0",
    "ajv": "^8.20.0",
    "@clack/prompts": "^1.4.0",
    "commander": "^12.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
