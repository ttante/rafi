{
  "name": "ai-foreman",
  "version": "1.0.6",
  "description": "An orchestrator that keeps Codex CLI / Claude Code builders moving through their step list unattended. Part of Rafi.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttante/foreman.git"
  },
  "bugs": {
    "url": "https://github.com/ttante/foreman/issues"
  },
  "homepage": "https://github.com/ttante/foreman#readme",
  "bin": {
    "ai-foreman": "./dist/index.js"
  },
  "exports": {
    "./cli/tickets.js": {
      "types": "./dist/cli/tickets.d.ts",
      "default": "./dist/cli/tickets.js"
    },
    "./cli/start.js": {
      "types": "./dist/cli/start.d.ts",
      "default": "./dist/cli/start.js"
    },
    "./cli/status.js": {
      "types": "./dist/cli/status.d.ts",
      "default": "./dist/cli/status.js"
    },
    "./cli/doctor.js": {
      "types": "./dist/cli/doctor.d.ts",
      "default": "./dist/cli/doctor.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "foreman.yaml",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agent",
    "orchestrator",
    "automation",
    "llm",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.2.1",
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.148"
  },
  "dependencies": {
    "special-agents": "workspace:*",
    "@clack/prompts": "^1.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.10.0",
    "commander": "^12.1.0",
    "luxon": "^3.7.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
