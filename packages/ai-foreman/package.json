{
  "name": "ai-foreman",
  "version": "1.7.6",
  "description": "An orchestrator that keeps Codex CLI / Claude Code builders moving through their step list unattended. Part of Rafi.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttante/rafi.git",
    "directory": "packages/ai-foreman"
  },
  "bugs": {
    "url": "https://github.com/ttante/rafi/issues"
  },
  "homepage": "https://github.com/ttante/rafi/tree/main/packages/ai-foreman#readme",
  "bin": {
    "ai-foreman": "dist/index.js"
  },
  "exports": {
    "./activity.js": {
      "types": "./dist/activity.d.ts",
      "default": "./dist/activity.js"
    },
    "./agent-run.js": {
      "types": "./dist/agentRun.d.ts",
      "default": "./dist/agentRun.js"
    },
    "./interviews.js": {
      "types": "./dist/interviews.d.ts",
      "default": "./dist/interviews.js"
    },
    "./provider-questions.js": {
      "types": "./dist/providerQuestions.d.ts",
      "default": "./dist/providerQuestions.js"
    },
    "./runtime-readiness.js": {
      "types": "./dist/runtimeReadiness.d.ts",
      "default": "./dist/runtimeReadiness.js"
    },
    "./claude-adapter.js": {
      "types": "./dist/adapters/claude.d.ts",
      "default": "./dist/adapters/claude.js"
    },
    "./roles.js": {
      "types": "./dist/roles.d.ts",
      "default": "./dist/roles.js"
    },
    "./build-runs.js": {
      "types": "./dist/buildRuns.d.ts",
      "default": "./dist/buildRuns.js"
    },
    "./workflow-db.js": {
      "types": "./dist/workflowDb.d.ts",
      "default": "./dist/workflowDb.js"
    },
    "./session-lifecycle.js": {
      "types": "./dist/sessionLifecycle.d.ts",
      "default": "./dist/sessionLifecycle.js"
    },
    "./operation-recovery.js": {
      "types": "./dist/operationRecovery.d.ts",
      "default": "./dist/operationRecovery.js"
    },
    "./ticket-planning.js": {
      "types": "./dist/ticketPlanning.d.ts",
      "default": "./dist/ticketPlanning.js"
    },
    "./tickets/source-fetch.js": {
      "types": "./dist/tickets/sourceFetch.d.ts",
      "default": "./dist/tickets/sourceFetch.js"
    },
    "./tickets/setup-config.js": {
      "types": "./dist/tickets/setupConfig.d.ts",
      "default": "./dist/tickets/setupConfig.js"
    },
    "./ticket-reset.js": {
      "types": "./dist/tickets/reset.d.ts",
      "default": "./dist/tickets/reset.js"
    },
    "./sources/source-registry.js": {
      "types": "./dist/sources/sourceRegistry.d.ts",
      "default": "./dist/sources/sourceRegistry.js"
    },
    "./cli/tickets.js": {
      "types": "./dist/cli/tickets.d.ts",
      "default": "./dist/cli/tickets.js"
    },
    "./cli/start.js": {
      "types": "./dist/cli/start.d.ts",
      "default": "./dist/cli/start.js"
    },
    "./cli/status.js": {
      "types": "./dist/cli/status.d.ts",
      "default": "./dist/cli/status.js"
    },
    "./cli/doctor.js": {
      "types": "./dist/cli/doctor.d.ts",
      "default": "./dist/cli/doctor.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "foreman.yaml",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:live-providers": "RAFI_LIVE_PROVIDER_SESSIONS=1 tsx --test test/providerSmoke.test.ts",
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agent",
    "orchestrator",
    "automation",
    "llm",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.2.1",
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.148"
  },
  "dependencies": {
    "special-agents": "0.8.4",
    "rafi-spec": "0.8.4",
    "@clack/prompts": "^1.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.10.0",
    "commander": "^12.1.0",
    "luxon": "^3.7.2",
    "parse5": "7.2.1",
    "pdfjs-dist": "4.10.38",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
